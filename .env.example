# Leave keys empty to run the documented extractive fallback without API calls.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=

# For another provider exposing the OpenAI Chat Completions API:
# Set LLM_PROVIDER=openai_compatible, LLM_MODEL to its model, and both values below.
LLM_API_KEY=
LLM_BASE_URL=

# Groq example (replace the values above; put your Groq key in LLM_API_KEY):
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=openai/gpt-oss-20b
# LLM_BASE_URL=https://api.groq.com/openai/v1
